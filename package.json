{
  "name": "tether",
  "version": "0.1.0",
  "description": "Tether: durable SDLC orchestrator for CLI coding agents (Claude Code, Codex, OpenCode) with a visual pipeline builder and an Obsidian knowledge graph",
  "type": "module",
  "main": "dist/app/main.js",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "tether": "dist/cli.js",
    "aorch": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts serve",
    "tether": "tsx src/cli.ts",
    "aorch": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build web",
    "build": "npm run build:server && npm run build:web"
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@blobatar/react": "2.7.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ascii-reveal": "github:quanhoangindex/ascii-reveal#f602e204232d2d31de2b67c66a166bcdbde51602",
    "blobatar": "2.7.0",
    "electron": "35.7.5",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
